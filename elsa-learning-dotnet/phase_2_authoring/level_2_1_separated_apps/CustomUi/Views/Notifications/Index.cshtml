@model NotificationsViewModel
@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>
<p class="muted">
    From CustomApi (<code>GET /api/notifications</code>, stored in <code>custom.sqlite.db</code>). The workflows send them
    with the <strong>HTTP Request</strong> activity (<code>POST /api/notifications</code> — swap the URL for a Teams/Slack
    webhook), and CustomApi adds one for each <strong>Run Task</strong>. Emails from <strong>Send Email</strong> go to the
    SMTP server configured on the Elsa Server.
</p>

@if (Model.Error is not null) { <div class="box error" role="alert">@Model.Error</div> }

@if (Model.Error is null && Model.NeedsAction.Count == 0 && Model.History.Count == 0)
{
    <div class="box"><p><strong>No notifications yet.</strong></p></div>
}

@if (Model.NeedsAction.Count > 0)
{
    <section class="box">
        <h3>Needs your action (@Model.NeedsAction.Count)</h3>
        <p class="muted">The approval these notifications asked for is still pending. Once it is decided, the notification moves to History and the links are removed.</p>
        <div class="tablewrap">
            <table>
                <thead><tr><th>Received (UTC)</th><th>Title</th><th>Message</th><th>Action</th></tr></thead>
                <tbody>
                    @foreach (var n in Model.NeedsAction)
                    {
                        // Email-link pattern: both links resume the workflow directly, so they work only once.
                        var direct = !string.IsNullOrWhiteSpace(n.RejectLink);
                        <tr data-action-row>
                            <td>@n.ReceivedAt.ToString("HH:mm:ss")</td>
                            <td><strong>@n.Title</strong>@if (n.OrderId is not null) { <br /><span class="mono muted">@n.OrderId</span> }</td>
                            <td>@n.Message</td>
                            <td data-action-cell>
                                @if (direct)
                                {
                                    <a data-once href="@n.Link" target="_blank">Approve</a><text> · </text><a data-once href="@n.RejectLink" target="_blank">Reject</a>
                                }
                                else
                                {
                                    <a asp-controller="Approvals" asp-action="Index">Review on Approvals</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.History.Count > 0)
{
    <section class="box">
        <h3>History (@Model.History.Count)</h3>
        <div class="tablewrap">
            <table>
                <thead><tr><th>Received (UTC)</th><th>Title</th><th>Message</th><th>Order status</th></tr></thead>
                <tbody>
                    @foreach (var n in Model.History)
                    {
                        <tr>
                            <td>@n.ReceivedAt.ToString("HH:mm:ss")</td>
                            <td><strong>@n.Title</strong>@if (n.OrderId is not null) { <br /><span class="mono muted">@n.OrderId</span> }</td>
                            <td>@n.Message</td>
                            <td>@(n.OrderStatus ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
