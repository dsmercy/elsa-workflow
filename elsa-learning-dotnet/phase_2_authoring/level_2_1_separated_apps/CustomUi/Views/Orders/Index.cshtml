@model List<OrderDto>
@{
    ViewData["Title"] = "Orders";
}

<h2>Orders</h2>
<p class="muted">
    From CustomApi (<code>GET /api/orders</code>, stored in <code>custom.sqlite.db</code>), newest first.
    A waiting order's status is updated when its workflow calls back <code>PUT /api/orders/{id}/status</code>.
</p>

@if (ViewBag.Error is string error)
{
    <div class="box error" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <p>No orders yet. <a asp-action="Create">Create one</a>.</p>
}
else
{
    <div class="tablewrap">
        <table>
            <thead>
                <tr><th>Created (UTC)</th><th>Pattern</th><th>Placed by</th><th>Order</th><th>Status</th><th>Workflow instance</th><th>Order ID</th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td>@o.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@o.Pattern</td>
                        <td>@o.CreatedBy</td>
                        <td>@o.Product, @o.Amount.ToString("0.00")</td>
                        <td><strong>@(o.IsWaiting ? "waiting for approval…" : o.Status)</strong>@if (o.Error is not null) { <br /><span class="error">@o.Error</span> }</td>
                        <td class="mono">@(o.WorkflowInstanceId ?? "—")</td>
                        <td class="mono">@o.Id</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
