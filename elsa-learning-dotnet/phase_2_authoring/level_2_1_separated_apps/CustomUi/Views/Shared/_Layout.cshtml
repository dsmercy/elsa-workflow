<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Level 2.1</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
        header { border-bottom: 1px solid #d0d7de; margin-bottom: 1.5rem; }
        nav { display: flex; gap: 1rem; flex-wrap: wrap; margin: .5rem 0 1rem; }
        nav a { color: #0969da; text-decoration: none; }
        label { display: block; margin-top: .75rem; font-weight: 600; }
        input, select { padding: .4rem; width: 100%; max-width: 32rem; }
        button { margin-top: 1rem; padding: .5rem 1rem; cursor: pointer; }
        td button { margin-top: 0; padding: .3rem .7rem; }
        .error { color: #cf222e; }
        .ok { color: #1a7f37; }
        .box { border: 1px solid #d0d7de; border-radius: 6px; padding: 1rem; margin-top: 1.5rem; }
        dt { font-weight: 600; margin-top: .5rem; }
        dd { margin-left: 0; font-family: ui-monospace, monospace; word-break: break-all; }
        table { border-collapse: collapse; width: 100%; margin-top: .5rem; }
        th, td { text-align: left; padding: .4rem .5rem; border-bottom: 1px solid #d0d7de; vertical-align: top; }
        code, .mono { font-family: ui-monospace, monospace; font-size: .9em; }
        .muted { color: #59636e; }
        .tablewrap { overflow-x: auto; }
        form.inline { display: inline; }
        button:disabled { opacity: .5; cursor: not-allowed; }
    </style>
</head>
<body>
    <header>
        <h1>Phase 2 · Level 2.1 · Separated apps (CustomUi)</h1>
        <nav>
            <a asp-controller="Orders" asp-action="Create">New order</a>
            <a asp-controller="Orders" asp-action="Index">Orders</a>
            <a asp-controller="Approvals" asp-action="Index">Approvals</a>
            <a asp-controller="Notifications" asp-action="Index">Notifications</a>
            <a href="https://localhost:6001" target="_blank">Elsa Studio ↗</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <script>
        // One decision per row: once a row's form is submitted or a one-time link is opened, lock the row
        // so the same approval cannot be sent twice. After the redirect the row is gone (no longer waiting).
        document.addEventListener('submit', e => {
            const row = e.target.closest('[data-action-row]');
            if (!row) return;
            const clicked = e.submitter;
            row.querySelectorAll('button').forEach(b => b.disabled = true);
            if (clicked) clicked.textContent = 'Sending…';
        });
        document.addEventListener('click', e => {
            const link = e.target.closest('a[data-once]');
            if (!link) return;
            const cell = link.closest('[data-action-cell]');
            if (!cell) return;
            // Let the browser open the link first, then replace both links with a note.
            setTimeout(() => { cell.innerHTML = '<span class="muted">Decision sent. Refresh to update.</span>'; }, 0);
        });
        // Coming back with the browser's Back button can restore a locked page; reload it to get the current state.
        window.addEventListener('pageshow', e => { if (e.persisted) location.reload(); });
    </script>
</body>
</html>
