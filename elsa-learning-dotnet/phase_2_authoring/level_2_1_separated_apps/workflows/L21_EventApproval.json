{
  "id": "l21eventapprove1",
  "definitionId": "L21_EventApproval",
  "name": "L21_EventApproval",
  "description": "Single approver: Correlate → notify (Execute Workflow) → wait for Event \"OrderReviewed\" (CustomApi triggers it via POST /elsa/api/events/OrderReviewed/trigger) → Decision → PUT status to CustomApi → Publish Event + Dispatch Workflow.",
  "version": 1,
  "toolVersion": "3.9.0.0",
  "variables": [
    { "id": "l21evVarOrderId", "name": "OrderId", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21evVarProduct", "name": "Product", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21evVarAmount", "name": "Amount", "typeName": "Double", "isArray": false, "value": "0", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21evVarReview", "name": "Review", "typeName": "Object", "isArray": false, "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21evVarStatus", "name": "Status", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" }
  ],
  "inputs": [
    { "type": "Object", "name": "Order", "displayName": "Order", "description": "The order submitted through CustomApi (POST /api/orders).", "category": "", "uiHint": "singleline", "isArray": false }
  ],
  "outputs": [
    { "type": "String", "name": "Status", "displayName": "Status", "description": "approved or rejected", "category": "", "isArray": false }
  ],
  "outcomes": [],
  "customProperties": {},
  "isReadonly": false,
  "isLatest": true,
  "isPublished": false,
  "options": { "autoUpdateConsumingWorkflows": false },
  "root": {
    "type": "Elsa.Flowchart",
    "version": 1,
    "id": "l21evFlow",
    "metadata": {},
    "customProperties": {},
    "activities": [
      {
        "script": { "typeName": "String", "expression": { "type": "Literal", "value": "const o = getInput(\"Order\");\nvariables.OrderId = o.OrderId;\nvariables.Product = o.Product;\nvariables.Amount = o.Amount;" } },
        "id": "l21evCapture",
        "name": "CaptureOrder",
        "type": "Elsa.RunJavaScript",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Copy order into variables", "designer": { "position": { "x": -900, "y": 200 } } }
      },
      {
        "correlationId": { "typeName": "String", "expression": { "type": "JavaScript", "value": "variables.OrderId" } },
        "id": "l21evCorrelate",
        "name": "CorrelateByOrderId",
        "type": "Elsa.Correlate",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Correlation ID = OrderId", "designer": { "position": { "x": -680, "y": 200 } } }
      },
      {
        "value": { "typeName": "String", "expression": { "type": "Liquid", "value": "Order {{ Variables.Product }} ({{ Variables.Amount }}) · Event approval" } },
        "id": "l21evSetName",
        "name": "NameInstance",
        "type": "Elsa.SetName",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Name the instance", "designer": { "position": { "x": -460, "y": 200 } } }
      },
      {
        "condition": { "typeName": "Boolean", "expression": { "type": "JavaScript", "value": "variables.Amount > 1000" } },
        "id": "l21evDecision",
        "name": "NeedsApproval",
        "type": "Elsa.FlowDecision",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Amount > 1000?", "designer": { "position": { "x": -240, "y": 200 } } }
      },
      {
        "variable": { "id": "l21evVarStatus", "name": "Status", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "Literal", "value": "approved" } },
        "id": "l21evAutoApprove",
        "name": "AutoApprove",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Status = approved (auto)", "designer": { "position": { "x": 300, "y": 360 } } }
      },
      {
        "workflowDefinitionId": { "typeName": "String", "expression": { "type": "Literal", "value": "L21_SendNotification" } },
        "waitForCompletion": { "typeName": "Boolean", "expression": { "type": "Literal", "value": "true" } },
        "input": {
          "typeName": "ObjectDictionary",
          "expression": {
            "type": "JavaScript",
            "value": "({ Title: \"Approval needed: \" + variables.Product, Message: \"Order \" + variables.OrderId + \" for \" + variables.Amount + \" is waiting for your approval.\", OrderId: variables.OrderId, ApproveLink: \"https://localhost:5201/Approvals\", RejectLink: \"\", Pattern: \"Event\", Stage: \"\" })"
          }
        },
        "id": "l21evNotify",
        "name": "NotifyApprover",
        "type": "Elsa.ExecuteWorkflow",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Notify approver (child workflow)", "designer": { "position": { "x": 0, "y": 60 } } }
      },
      {
        "eventName": { "typeName": "String", "expression": { "type": "Literal", "value": "OrderReviewed" } },
        "result": { "typeName": "Object", "memoryReference": { "id": "l21evVarReview" } },
        "id": "l21evWait",
        "name": "WaitForReview",
        "type": "Elsa.Event",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Wait for \"OrderReviewed\"", "designer": { "position": { "x": 260, "y": 60 } } }
      },
      {
        "variable": { "id": "l21evVarStatus", "name": "Status", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "variables.Review.Approved ? \"approved\" : \"rejected\"" } },
        "id": "l21evApplyReview",
        "name": "ApplyReview",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Status from the review", "designer": { "position": { "x": 520, "y": 60 } } }
      },
      {
        "outputName": { "typeName": "String", "expression": { "type": "Literal", "value": "Status" } },
        "outputValue": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "variables.Status" } },
        "id": "l21evOutput",
        "name": "OutputStatus",
        "type": "Elsa.SetOutput",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Output Status", "designer": { "position": { "x": 780, "y": 200 } } }
      },
      {
        "expectedStatusCodes": { "typeName": "Int32[]", "expression": { "type": "Object", "value": "[200]" } },
        "url": { "typeName": "System.Uri, System.Private.Uri", "expression": { "type": "JavaScript", "value": "\"https://localhost:5101/api/orders/\" + variables.OrderId + \"/status\"" } },
        "method": { "typeName": "String", "expression": { "type": "Literal", "value": "PUT" } },
        "contentType": { "typeName": "String", "expression": { "type": "Literal", "value": "application/json" } },
        "content": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "JSON.stringify({ status: variables.Status })" } },
        "id": "l21evReport",
        "name": "ReportStatus",
        "type": "Elsa.FlowSendHttpRequest",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "PUT status to CustomApi", "designer": { "position": { "x": 780, "y": 360 } } }
      },
      {
        "eventName": { "typeName": "String", "expression": { "type": "Literal", "value": "OrderDecided" } },
        "isLocalEvent": { "typeName": "Boolean", "expression": { "type": "Literal", "value": "false" } },
        "payload": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "({ OrderId: variables.OrderId, Status: variables.Status, Pattern: \"Event\" })" } },
        "id": "l21evPublish",
        "name": "PublishDecided",
        "type": "Elsa.PublishEvent",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Publish \"OrderDecided\"", "designer": { "position": { "x": 1020, "y": 200 } } }
      },
      {
        "workflowDefinitionId": { "typeName": "String", "expression": { "type": "Literal", "value": "L21_OrderAudit" } },
        "waitForCompletion": { "typeName": "Boolean", "expression": { "type": "Literal", "value": "false" } },
        "input": { "typeName": "ObjectDictionary", "expression": { "type": "JavaScript", "value": "({ OrderId: variables.OrderId, Status: variables.Status, Pattern: \"Event\" })" } },
        "id": "l21evAudit",
        "name": "DispatchAudit",
        "type": "Elsa.DispatchWorkflow",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Dispatch audit (fire and forget)", "designer": { "position": { "x": 1260, "y": 200 } } }
      }
    ],
    "connections": [
      { "source": { "activity": "l21evCapture", "port": "Done" }, "target": { "activity": "l21evCorrelate", "port": "In" } },
      { "source": { "activity": "l21evCorrelate", "port": "Done" }, "target": { "activity": "l21evSetName", "port": "In" } },
      { "source": { "activity": "l21evSetName", "port": "Done" }, "target": { "activity": "l21evDecision", "port": "In" } },
      { "source": { "activity": "l21evDecision", "port": "False" }, "target": { "activity": "l21evAutoApprove", "port": "In" } },
      { "source": { "activity": "l21evDecision", "port": "True" }, "target": { "activity": "l21evNotify", "port": "In" } },
      { "source": { "activity": "l21evNotify", "port": "Done" }, "target": { "activity": "l21evWait", "port": "In" } },
      { "source": { "activity": "l21evWait", "port": "Done" }, "target": { "activity": "l21evApplyReview", "port": "In" } },
      { "source": { "activity": "l21evApplyReview", "port": "Done" }, "target": { "activity": "l21evOutput", "port": "In" } },
      { "source": { "activity": "l21evAutoApprove", "port": "Done" }, "target": { "activity": "l21evOutput", "port": "In" } },
      { "source": { "activity": "l21evOutput", "port": "Done" }, "target": { "activity": "l21evReport", "port": "In" } },
      { "source": { "activity": "l21evReport", "port": "Done" }, "target": { "activity": "l21evPublish", "port": "In" } },
      { "source": { "activity": "l21evPublish", "port": "Done" }, "target": { "activity": "l21evAudit", "port": "In" } }
    ]
  }
}
