{
  "id": "l21multistage001",
  "definitionId": "L21_MultiStageApproval",
  "name": "L21_MultiStageApproval",
  "description": "Multi-stage approval with a State Machine: Routing (CustomApi sets Order.RequireManagerApproval: Customer → true, CompanyEmployee → false) → ManagerReview → (Event L21.ManagerReviewed) → ManagerDecided → FinanceReview → (Event L21.FinanceReviewed) → FinanceDecided → Approved, or Rejected at either stage.",
  "version": 1,
  "toolVersion": "3.9.0.0",
  "variables": [
    { "id": "l21msVarOrderId", "name": "OrderId", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21msVarProduct", "name": "Product", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21msVarAmount", "name": "Amount", "typeName": "Double", "isArray": false, "value": "0", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21msVarStatus", "name": "Status", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21msVarReview", "name": "Review", "typeName": "Object", "isArray": false, "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l21msVarNeedsManager", "name": "RequireManagerApproval", "typeName": "Boolean", "isArray": false, "value": "true", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" }
  ],
  "inputs": [
    { "type": "Object", "name": "Order", "displayName": "Order", "description": "The order submitted through CustomApi (POST /api/orders).", "category": "", "uiHint": "singleline", "isArray": false }
  ],
  "outputs": [
    { "type": "String", "name": "Status", "displayName": "Status", "description": "approved or rejected", "category": "", "isArray": false }
  ],
  "outcomes": [],
  "customProperties": {},
  "isReadonly": false,
  "isLatest": true,
  "isPublished": false,
  "options": { "autoUpdateConsumingWorkflows": false },
  "root": {
    "type": "Elsa.Flowchart",
    "version": 1,
    "id": "l21msFlow",
    "metadata": {},
    "customProperties": {},
    "activities": [
      {
        "script": { "typeName": "String", "expression": { "type": "Literal", "value": "const o = getInput(\"Order\");\nvariables.OrderId = o.OrderId;\nvariables.Product = o.Product;\nvariables.Amount = o.Amount;\n// Decided by CustomApi (Customer → true, CompanyEmployee → false). Missing → ask the manager, to be safe.\nvariables.RequireManagerApproval = o.RequireManagerApproval !== false;" } },
        "id": "l21msCapture",
        "name": "CaptureOrder",
        "type": "Elsa.RunJavaScript",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Copy order into variables", "designer": { "position": { "x": -700, "y": 200 } } }
      },
      {
        "correlationId": { "typeName": "String", "expression": { "type": "JavaScript", "value": "variables.OrderId" } },
        "id": "l21msCorrelate",
        "name": "CorrelateByOrderId",
        "type": "Elsa.Correlate",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Correlation ID = OrderId", "designer": { "position": { "x": -460, "y": 200 } } }
      },
      {
        "initialState": "Routing",
        "states": [
          {
            "name": "ManagerReview",
            "entry": {
              "type": "Elsa.Sequence",
              "version": 1,
              "id": "l21msManagerEntry",
              "variables": [],
              "activities": [
                {
                  "value": { "typeName": "String", "expression": { "type": "Liquid", "value": "Order {{ Variables.Product }} ({{ Variables.Amount }}) · awaiting Manager" } },
                  "id": "l21msManagerName",
                  "type": "Elsa.SetName",
                  "version": 1
                },
                {
                  "workflowDefinitionId": { "typeName": "String", "expression": { "type": "Literal", "value": "L21_SendNotification" } },
                  "waitForCompletion": { "typeName": "Boolean", "expression": { "type": "Literal", "value": "true" } },
                  "input": { "typeName": "ObjectDictionary", "expression": { "type": "JavaScript", "value": "({ Title: \"Stage 1 of 2 — manager approval: \" + variables.Product, Message: \"Order \" + variables.OrderId + \" for \" + variables.Amount + \" needs the MANAGER's approval.\", OrderId: variables.OrderId, ApproveLink: \"https://localhost:5201/Approvals\", RejectLink: \"\", Pattern: \"MultiStage\", Stage: \"Manager\" })" } },
                  "id": "l21msManagerNotify",
                  "type": "Elsa.ExecuteWorkflow",
                  "version": 1
                }
              ]
            }
          },
          {
            "name": "FinanceReview",
            "entry": {
              "type": "Elsa.Sequence",
              "version": 1,
              "id": "l21msFinanceEntry",
              "variables": [],
              "activities": [
                {
                  "value": { "typeName": "String", "expression": { "type": "Liquid", "value": "Order {{ Variables.Product }} ({{ Variables.Amount }}) · awaiting Finance" } },
                  "id": "l21msFinanceName",
                  "type": "Elsa.SetName",
                  "version": 1
                },
                {
                  "workflowDefinitionId": { "typeName": "String", "expression": { "type": "Literal", "value": "L21_SendNotification" } },
                  "waitForCompletion": { "typeName": "Boolean", "expression": { "type": "Literal", "value": "true" } },
                  "input": { "typeName": "ObjectDictionary", "expression": { "type": "JavaScript", "value": "({ Title: (variables.RequireManagerApproval ? \"Stage 2 of 2 — finance approval: \" : \"Finance approval (employee order): \") + variables.Product, Message: variables.RequireManagerApproval ? \"The manager approved order \" + variables.OrderId + \". FINANCE approval is now needed.\" : \"Order \" + variables.OrderId + \" for \" + variables.Amount + \" was placed by a company employee, so it goes straight to FINANCE approval.\", OrderId: variables.OrderId, ApproveLink: \"https://localhost:5201/Approvals\", RejectLink: \"\", Pattern: \"MultiStage\", Stage: \"Finance\" })" } },
                  "id": "l21msFinanceNotify",
                  "type": "Elsa.ExecuteWorkflow",
                  "version": 1
                }
              ]
            }
          },
          { "name": "Routing" },
          { "name": "ManagerDecided" },
          { "name": "FinanceDecided" },
          {
            "name": "Approved",
            "entry": {
              "variable": { "id": "l21msVarStatus", "name": "Status", "typeName": "String", "value": "" },
              "value": { "typeName": "Object", "expression": { "type": "Literal", "value": "approved" } },
              "id": "l21msApprovedEntry",
              "type": "Elsa.SetVariable",
              "version": 1
            }
          },
          {
            "name": "Rejected",
            "entry": {
              "variable": { "id": "l21msVarStatus", "name": "Status", "typeName": "String", "value": "" },
              "value": { "typeName": "Object", "expression": { "type": "Literal", "value": "rejected" } },
              "id": "l21msRejectedEntry",
              "type": "Elsa.SetVariable",
              "version": 1
            }
          }
        ],
        "transitions": [
          {
            "name": "NeedsManager", "displayName": "Customer order → manager", "from": "Routing", "to": "ManagerReview",
            "condition": { "typeName": "Boolean", "expression": { "type": "JavaScript", "value": "variables.RequireManagerApproval === true" } }
          },
          {
            "name": "SkipManager", "displayName": "Employee order → finance", "from": "Routing", "to": "FinanceReview",
            "condition": { "typeName": "Boolean", "expression": { "type": "JavaScript", "value": "variables.RequireManagerApproval !== true" } }
          },
          {
            "name": "ManagerReviews", "displayName": "Manager reviews", "from": "ManagerReview", "to": "ManagerDecided",
            "trigger": {
              "eventName": { "typeName": "String", "expression": { "type": "Literal", "value": "L21.ManagerReviewed" } },
              "result": { "typeName": "Object", "memoryReference": { "id": "l21msVarReview" } },
              "id": "l21msTrigManager", "type": "Elsa.Event", "version": 1
            }
          },
          {
            "name": "ManagerApproved", "displayName": "Approved → finance", "from": "ManagerDecided", "to": "FinanceReview",
            "condition": { "typeName": "Boolean", "expression": { "type": "JavaScript", "value": "variables.Review.Approved === true" } }
          },
          {
            "name": "ManagerRejected", "displayName": "Rejected", "from": "ManagerDecided", "to": "Rejected",
            "condition": { "typeName": "Boolean", "expression": { "type": "JavaScript", "value": "variables.Review.Approved !== true" } }
          },
          {
            "name": "FinanceReviews", "displayName": "Finance reviews", "from": "FinanceReview", "to": "FinanceDecided",
            "trigger": {
              "eventName": { "typeName": "String", "expression": { "type": "Literal", "value": "L21.FinanceReviewed" } },
              "result": { "typeName": "Object", "memoryReference": { "id": "l21msVarReview" } },
              "id": "l21msTrigFinance", "type": "Elsa.Event", "version": 1
            }
          },
          {
            "name": "FinanceApproved", "displayName": "Approved", "from": "FinanceDecided", "to": "Approved",
            "condition": { "typeName": "Boolean", "expression": { "type": "JavaScript", "value": "variables.Review.Approved === true" } }
          },
          {
            "name": "FinanceRejected", "displayName": "Rejected", "from": "FinanceDecided", "to": "Rejected",
            "condition": { "typeName": "Boolean", "expression": { "type": "JavaScript", "value": "variables.Review.Approved !== true" } }
          }
        ],
        "id": "l21msStateMachine",
        "name": "ApprovalStages",
        "type": "Elsa.StateMachine",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Manager → Finance (State Machine)", "designer": { "position": { "x": -200, "y": 200 } } }
      },
      {
        "value": { "typeName": "String", "expression": { "type": "Liquid", "value": "Order {{ Variables.Product }} ({{ Variables.Amount }}) · {{ Variables.Status }}" } },
        "id": "l21msFinalName",
        "name": "NameWithResult",
        "type": "Elsa.SetName",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Rename with the result", "designer": { "position": { "x": 100, "y": 200 } } }
      },
      {
        "outputName": { "typeName": "String", "expression": { "type": "Literal", "value": "Status" } },
        "outputValue": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "variables.Status" } },
        "id": "l21msOutput",
        "name": "OutputStatus",
        "type": "Elsa.SetOutput",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Output Status", "designer": { "position": { "x": 360, "y": 200 } } }
      },
      {
        "expectedStatusCodes": { "typeName": "Int32[]", "expression": { "type": "Object", "value": "[200]" } },
        "url": { "typeName": "System.Uri, System.Private.Uri", "expression": { "type": "JavaScript", "value": "\"https://localhost:5101/api/orders/\" + variables.OrderId + \"/status\"" } },
        "method": { "typeName": "String", "expression": { "type": "Literal", "value": "PUT" } },
        "contentType": { "typeName": "String", "expression": { "type": "Literal", "value": "application/json" } },
        "content": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "JSON.stringify({ status: variables.Status })" } },
        "id": "l21msReport",
        "name": "ReportStatus",
        "type": "Elsa.FlowSendHttpRequest",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "PUT status to CustomApi", "designer": { "position": { "x": 620, "y": 200 } } }
      }
    ],
    "connections": [
      { "source": { "activity": "l21msCapture", "port": "Done" }, "target": { "activity": "l21msCorrelate", "port": "In" } },
      { "source": { "activity": "l21msCorrelate", "port": "Done" }, "target": { "activity": "l21msStateMachine", "port": "In" } },
      { "source": { "activity": "l21msStateMachine", "port": "Done" }, "target": { "activity": "l21msFinalName", "port": "In" } },
      { "source": { "activity": "l21msFinalName", "port": "Done" }, "target": { "activity": "l21msOutput", "port": "In" } },
      { "source": { "activity": "l21msOutput", "port": "Done" }, "target": { "activity": "l21msReport", "port": "In" } }
    ]
  }
}
