@model CreateOrderViewModel
@{
    ViewData["Title"] = "Create order";
    var patterns = Enum.GetValues<ApprovalPattern>()
        .Select(p => new SelectListItem(ApprovalPatterns.Describe(p), p.ToString()));
}

<p>
    Submitting this form starts the <strong>published</strong> Studio workflow configured for the chosen pattern,
    passing the order as the <code>Order</code> input. Amounts up to 1000 are approved automatically;
    higher amounts follow the pattern's approval path (the multi-stage pattern always asks both approvers).
</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label asp-for="Form.Pattern">Approval pattern</label>
    <select asp-for="Form.Pattern" asp-items="patterns"></select>

    <label asp-for="Form.Product">Product</label>
    <input asp-for="Form.Product" />
    <span asp-validation-for="Form.Product" class="error"></span>

    <label asp-for="Form.Amount">Amount</label>
    <input asp-for="Form.Amount" type="number" step="0.01" />
    <span asp-validation-for="Form.Amount" class="error"></span>

    <div><button type="submit">Create order</button></div>
</form>

@if (Model.Error is not null)
{
    <div class="box error" role="alert">@Model.Error</div>
}

@if (Model.Result is { } r)
{
    <div class="box">
        @if (r.IsWaiting)
        {
            <h2>Order waiting for approval</h2>
            <p>
                The workflow is <strong>suspended</strong> at a bookmark (saved in SQLite, using no CPU).
                Approve or reject it on the <a asp-controller="Approvals" asp-action="Index">Approvals</a> page
                @if (r.Pattern == ApprovalPattern.EmailLink) { <text>or with the link in the email / <a asp-controller="Notifications" asp-action="Index">notification</a></text> }.
            </p>
        }
        else if (r.IsFinishing)
        {
            <h2>Order @r.OrderStatus</h2>
            <p class="muted">
                Decided. The instance is still <em>suspended</em> for a moment while the dispatched
                <code>L2_OrderAudit</code> child workflow runs; it finishes on its own (see the Orders page).
            </p>
        }
        else
        {
            <h2>Order @(r.OrderStatus ?? "(no status output)")</h2>
        }
        <dl>
            <dt>Pattern</dt>
            <dd>@ApprovalPatterns.Describe(r.Pattern)</dd>
            <dt>Order</dt>
            <dd>@r.Order.Product, @r.Order.Amount.ToString("0.00")</dd>
            <dt>Workflow output "Status"</dt>
            <dd>@(r.OrderStatus ?? (r.IsWaiting ? "(not set yet — waiting)" : "(missing — check the output name in Studio)"))</dd>
            <dt>Workflow Status / SubStatus</dt>
            <dd>@r.WorkflowStatus / @r.WorkflowSubStatus</dd>
            <dt>Workflow instance ID</dt>
            <dd>@r.WorkflowInstanceId</dd>
            <dt>Order ID (= correlation ID)</dt>
            <dd>@r.Order.OrderId</dd>
        </dl>
        <p>Find this instance in Studio → <em>Workflows → Instances</em> to see which path ran.</p>
    </div>
}
