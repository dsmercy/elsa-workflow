{
  "id": "l2decidedlisten1",
  "definitionId": "L2_OrderDecidedListener",
  "name": "L2_OrderDecidedListener",
  "description": "Starts whenever any workflow publishes the event \"OrderDecided\" (Publish Event). Shows how workflows signal each other.",
  "version": 1,
  "toolVersion": "3.9.0.0",
  "variables": [
    { "id": "l2listenVarDecision", "name": "Decision", "typeName": "Object", "isArray": false, "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" }
  ],
  "inputs": [],
  "outputs": [],
  "outcomes": [],
  "customProperties": {},
  "isReadonly": false,
  "isLatest": true,
  "isPublished": false,
  "options": { "autoUpdateConsumingWorkflows": false },
  "root": {
    "type": "Elsa.Flowchart",
    "version": 1,
    "id": "l2listenFlow",
    "metadata": {},
    "customProperties": {},
    "activities": [
      {
        "eventName": { "typeName": "String", "expression": { "type": "Literal", "value": "OrderDecided" } },
        "result": { "typeName": "Object", "memoryReference": { "id": "l2listenVarDecision" } },
        "id": "l2listenEvent",
        "name": "OnOrderDecided",
        "type": "Elsa.Event",
        "version": 1,
        "customProperties": { "canStartWorkflow": true, "runAsynchronously": false },
        "metadata": { "displayText": "When \"OrderDecided\" is published", "designer": { "position": { "x": 0, "y": 100 } } }
      },
      {
        "expectedStatusCodes": { "typeName": "Int32[]", "expression": { "type": "Object", "value": "[200]" } },
        "url": { "typeName": "System.Uri, System.Private.Uri", "expression": { "type": "Literal", "value": "https://localhost:5001/notifications/webhook" } },
        "method": { "typeName": "String", "expression": { "type": "Literal", "value": "POST" } },
        "contentType": { "typeName": "String", "expression": { "type": "Literal", "value": "application/json" } },
        "content": {
          "typeName": "Object",
          "expression": {
            "type": "JavaScript",
            "value": "JSON.stringify({ title: \"Listener: OrderDecided received\", message: \"Another workflow published OrderDecided: \" + JSON.stringify(variables.Decision), orderId: variables.Decision ? variables.Decision.OrderId : null })"
          }
        },
        "id": "l2listenWebhook",
        "name": "ForwardToWebhook",
        "type": "Elsa.FlowSendHttpRequest",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Notify", "designer": { "position": { "x": 300, "y": 100 } } }
      }
    ],
    "connections": [
      { "source": { "activity": "l2listenEvent", "port": "Done" }, "target": { "activity": "l2listenWebhook", "port": "In" } }
    ]
  }
}
