@model NotificationsViewModel
@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>
<p class="muted">
    Messages the workflows sent with the <strong>HTTP Request</strong> activity (POST to
    <code>/notifications/webhook</code> — swap the URL for a Teams/Slack webhook) and with
    <strong>Run Task</strong> (in-app). Emails from <strong>Send Email</strong> go to the SMTP server
    in <code>appsettings.json → Smtp</code>, not here. Kept in memory; cleared on restart.
</p>

@if (Model.Error is not null) { <div class="box error" role="alert">@Model.Error</div> }

@if (Model.NeedsAction.Count == 0 && Model.History.Count == 0)
{
    <div class="box"><p><strong>No notifications yet.</strong></p></div>
}

@if (Model.NeedsAction.Count > 0)
{
    <section class="box">
        <h3>Needs your action (@Model.NeedsAction.Count)</h3>
        <p class="muted">These orders are still waiting for a decision. Once an order is decided, its notification moves to History and the links are removed.</p>
        <div class="tablewrap">
            <table>
                <thead><tr><th>Received (UTC)</th><th>Title</th><th>Message</th><th>Action</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.NeedsAction)
                    {
                        var n = row.Notification;
                        // Email-link pattern: both links resume the workflow directly, so they work only once.
                        var direct = !string.IsNullOrWhiteSpace(n.RejectLink);
                        <tr data-action-row>
                            <td>@n.ReceivedAt.ToString("HH:mm:ss")</td>
                            <td><strong>@n.Title</strong>@if (n.OrderId is not null) { <br /><span class="mono muted">@n.OrderId</span> }</td>
                            <td>@n.Message</td>
                            <td data-action-cell>
                                @if (direct)
                                {
                                    <a data-once href="@n.Link" target="_blank">Approve</a><text> · </text><a data-once href="@n.RejectLink" target="_blank">Reject</a>
                                }
                                else if (!string.IsNullOrWhiteSpace(n.Link))
                                {
                                    <a href="@n.Link">Review on Approvals</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.History.Count > 0)
{
    <section class="box">
        <h3>History (@Model.History.Count)</h3>
        <div class="tablewrap">
            <table>
                <thead><tr><th>Received (UTC)</th><th>Title</th><th>Message</th><th>Order result</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.History)
                    {
                        var n = row.Notification;
                        <tr>
                            <td>@n.ReceivedAt.ToString("HH:mm:ss")</td>
                            <td><strong>@n.Title</strong>@if (n.OrderId is not null) { <br /><span class="mono muted">@n.OrderId</span> }</td>
                            <td>@n.Message</td>
                            <td>
                                @if (row.Outcome is not null) { <span>@row.Outcome</span> }
                                else if (row.HasLinks) { <span class="muted">superseded by a newer notification</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
