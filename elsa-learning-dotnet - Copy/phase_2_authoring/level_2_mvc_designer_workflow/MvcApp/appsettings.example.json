{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Http": {
    "BaseUrl": "https://localhost:5001",
    "BasePath": "/workflows"
  },
  "Identity": {
    "Tokens": {
      "SigningKey": "<random-32+-char-string>"
    },
    "Bootstrap": {
      "UserName": "admin",
      "Password": "<local-password>"
    }
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=elsa.sqlite.db"
  },
  "Workflow": {
    "DefinitionId": "<definition-id-copied-from-studio>",
    "Approvals": {
      "Event": "<definition-id-copied-from-studio>",
      "EmailLink": "<definition-id-copied-from-studio>",
      "RunTask": "<definition-id-copied-from-studio>",
      "MultiStage": "<definition-id-copied-from-studio>"
    }
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 2525,
    "SecureSocketOptions": "None",
    "RequireCredentials": false,
    "DefaultSender": "orders@l2.local"
  }
}
