{
  "id": "l2sendnotify001",
  "definitionId": "L2_SendNotification",
  "name": "L2_SendNotification",
  "description": "Child workflow: sends one notification by email (Send Email) and by webhook (HTTP Request). Called by the approval workflows with Execute Workflow.",
  "version": 1,
  "toolVersion": "3.9.0.0",
  "variables": [],
  "inputs": [
    { "type": "String", "name": "Title", "displayName": "Title", "description": "Subject / headline", "category": "", "uiHint": "singleline", "isArray": false },
    { "type": "String", "name": "Message", "displayName": "Message", "description": "Body text", "category": "", "uiHint": "singleline", "isArray": false },
    { "type": "String", "name": "OrderId", "displayName": "Order ID", "description": "", "category": "", "uiHint": "singleline", "isArray": false },
    { "type": "String", "name": "ApproveLink", "displayName": "Approve link", "description": "Optional link (approval page or approve URL)", "category": "", "uiHint": "singleline", "isArray": false },
    { "type": "String", "name": "RejectLink", "displayName": "Reject link", "description": "Optional reject URL (email-link pattern)", "category": "", "uiHint": "singleline", "isArray": false }
  ],
  "outputs": [],
  "outcomes": [],
  "customProperties": {},
  "isReadonly": false,
  "isLatest": true,
  "isPublished": false,
  "options": { "autoUpdateConsumingWorkflows": false },
  "root": {
    "type": "Elsa.Flowchart",
    "version": 1,
    "id": "l2notifyFlow",
    "metadata": {},
    "customProperties": {},
    "activities": [
      {
        "from": { "typeName": "String", "expression": { "type": "Literal", "value": "orders@l2.local" } },
        "to": { "typeName": "String[]", "expression": { "type": "Object", "value": "[\"manager@l2.local\"]" } },
        "subject": { "typeName": "String", "expression": { "type": "JavaScript", "value": "getInput(\"Title\")" } },
        "body": {
          "typeName": "String",
          "expression": {
            "type": "Liquid",
            "value": "<p>{{ Input.Message }}</p>{% if Input.RejectLink != empty %}<p><a href=\"{{ Input.ApproveLink }}\">Approve</a> | <a href=\"{{ Input.RejectLink }}\">Reject</a></p>{% elsif Input.ApproveLink != empty %}<p><a href=\"{{ Input.ApproveLink }}\">Open the approvals page</a></p>{% endif %}<p>Order: {{ Input.OrderId }}</p>"
          }
        },
        "id": "l2notifyEmail",
        "name": "SendEmail",
        "type": "Elsa.SendEmail",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Email the approver", "designer": { "position": { "x": 0, "y": 100 } } }
      },
      {
        "expectedStatusCodes": { "typeName": "Int32[]", "expression": { "type": "Object", "value": "[200]" } },
        "url": { "typeName": "System.Uri, System.Private.Uri", "expression": { "type": "Literal", "value": "https://localhost:5001/notifications/webhook" } },
        "method": { "typeName": "String", "expression": { "type": "Literal", "value": "POST" } },
        "contentType": { "typeName": "String", "expression": { "type": "Literal", "value": "application/json" } },
        "content": {
          "typeName": "Object",
          "expression": {
            "type": "JavaScript",
            "value": "JSON.stringify({ title: getInput(\"Title\"), message: getInput(\"Message\"), orderId: getInput(\"OrderId\"), link: getInput(\"ApproveLink\"), rejectLink: getInput(\"RejectLink\") })"
          }
        },
        "id": "l2notifyWebhook",
        "name": "PostWebhook",
        "type": "Elsa.FlowSendHttpRequest",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "POST to webhook (Teams/Slack stand-in)", "designer": { "position": { "x": 300, "y": 100 } } }
      }
    ],
    "connections": [
      { "source": { "activity": "l2notifyEmail", "port": "Done" }, "target": { "activity": "l2notifyWebhook", "port": "In" } }
    ]
  }
}
