{
  "id": "l3orderprocess1",
  "definitionId": "L3_OrderProcessing",
  "name": "L3_OrderProcessing",
  "description": "Phase 2 / Level 3: ForEach over lines → total; Decision → status; Switch → tier; Liquid → message.",
  "version": 1,
  "toolVersion": "3.9.0.0",
  "variables": [
    { "id": "l3varOrderId", "name": "OrderId", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l3varLineCount", "name": "LineCount", "typeName": "Int32", "isArray": false, "value": "0", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l3varTotal", "name": "Total", "typeName": "Double", "isArray": false, "value": "0", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l3varCurrentLine", "name": "CurrentLine", "typeName": "Object", "isArray": false, "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l3varStatus", "name": "Status", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l3varTier", "name": "Tier", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" },
    { "id": "l3varMessage", "name": "Message", "typeName": "String", "isArray": false, "value": "", "storageDriverTypeName": "Elsa.Workflows.WorkflowInstanceStorageDriver, Elsa.Workflows.Core" }
  ],
  "inputs": [
    { "type": "Object", "name": "Order", "displayName": "Order", "description": "The order (with Lines) submitted from the MVC form.", "category": "", "uiHint": "singleline", "isArray": false }
  ],
  "outputs": [
    { "type": "Double", "name": "Total", "displayName": "Total", "description": "Sum of Quantity * UnitPrice over all lines", "category": "", "isArray": false },
    { "type": "String", "name": "Status", "displayName": "Status", "description": "approved or needs_review", "category": "", "isArray": false },
    { "type": "String", "name": "Tier", "displayName": "Tier", "description": "Gold, Silver or Bronze", "category": "", "isArray": false },
    { "type": "String", "name": "Message", "displayName": "Message", "description": "Summary built with Liquid", "category": "", "isArray": false }
  ],
  "outcomes": [],
  "customProperties": {},
  "isReadonly": false,
  "isLatest": true,
  "isPublished": false,
  "options": { "autoUpdateConsumingWorkflows": false },
  "root": {
    "type": "Elsa.Flowchart",
    "version": 1,
    "id": "l3flowchart",
    "metadata": {},
    "customProperties": {},
    "activities": [
      {
        "variable": { "id": "l3varOrderId", "name": "OrderId", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "getInput(\"Order\").OrderId" } },
        "id": "l3captureId",
        "name": "CaptureOrderId",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "OrderId = input.OrderId", "designer": { "position": { "x": -1100, "y": 200 } } }
      },
      {
        "variable": { "id": "l3varLineCount", "name": "LineCount", "typeName": "Int32", "value": "0" },
        "value": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "getInput(\"Order\").Lines.Count" } },
        "id": "l3captureCount",
        "name": "CaptureLineCount",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "LineCount = input.Lines.Count", "designer": { "position": { "x": -850, "y": 200 } } }
      },
      {
        "items": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "getInput(\"Order\").Lines" } },
        "currentValue": { "typeName": "Object", "memoryReference": { "id": "l3varCurrentLine" } },
        "body": {
          "variable": { "id": "l3varTotal", "name": "Total", "typeName": "Double", "value": "0" },
          "value": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "variables.Total + variables.CurrentLine.Quantity * variables.CurrentLine.UnitPrice" } },
          "id": "l3addLine",
          "name": "AddLineTotal",
          "type": "Elsa.SetVariable",
          "version": 1,
          "customProperties": {},
          "metadata": { "displayText": "Total += Quantity * UnitPrice" }
        },
        "id": "l3forEachLine",
        "name": "ForEachLine",
        "type": "Elsa.ForEach",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "For each order line", "designer": { "position": { "x": -600, "y": 200 } } }
      },
      {
        "condition": { "typeName": "Boolean", "expression": { "type": "JavaScript", "value": "variables.Total > 1000" } },
        "id": "l3decision",
        "name": "TotalAbove1000",
        "type": "Elsa.FlowDecision",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Total > 1000?", "designer": { "position": { "x": -320, "y": 200 } } }
      },
      {
        "variable": { "id": "l3varStatus", "name": "Status", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "Literal", "value": "needs_review" } },
        "id": "l3statusReview",
        "name": "StatusNeedsReview",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Status = needs_review", "designer": { "position": { "x": -60, "y": 100 } } }
      },
      {
        "variable": { "id": "l3varStatus", "name": "Status", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "Literal", "value": "approved" } },
        "id": "l3statusApproved",
        "name": "StatusApproved",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Status = approved", "designer": { "position": { "x": -60, "y": 300 } } }
      },
      {
        "cases": [
          { "label": "Gold", "condition": { "type": "JavaScript", "value": "variables.Total >= 5000" } },
          { "label": "Silver", "condition": { "type": "JavaScript", "value": "variables.Total >= 1000" } }
        ],
        "mode": { "typeName": "Elsa.Workflows.SwitchMode, Elsa.Workflows.Core", "expression": { "type": "Literal", "value": "MatchFirst" } },
        "id": "l3tierSwitch",
        "name": "TierSwitch",
        "type": "Elsa.FlowSwitch",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Customer tier", "designer": { "position": { "x": 200, "y": 200 } } }
      },
      {
        "variable": { "id": "l3varTier", "name": "Tier", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "Literal", "value": "Gold" } },
        "id": "l3tierGold",
        "name": "TierGold",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Tier = Gold", "designer": { "position": { "x": 460, "y": 60 } } }
      },
      {
        "variable": { "id": "l3varTier", "name": "Tier", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "Literal", "value": "Silver" } },
        "id": "l3tierSilver",
        "name": "TierSilver",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Tier = Silver", "designer": { "position": { "x": 460, "y": 200 } } }
      },
      {
        "variable": { "id": "l3varTier", "name": "Tier", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "Literal", "value": "Bronze" } },
        "id": "l3tierBronze",
        "name": "TierBronze",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Tier = Bronze", "designer": { "position": { "x": 460, "y": 340 } } }
      },
      {
        "variable": { "id": "l3varMessage", "name": "Message", "typeName": "String", "value": "" },
        "value": { "typeName": "Object", "expression": { "type": "Liquid", "value": "Order {{ Variables.OrderId }} with {{ Variables.LineCount }} line(s): total {{ Variables.Total | round: 2 }}, tier {{ Variables.Tier }}, status {{ Variables.Status }}." } },
        "id": "l3message",
        "name": "BuildMessage",
        "type": "Elsa.SetVariable",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Message (Liquid)", "designer": { "position": { "x": 720, "y": 200 } } }
      },
      {
        "outputName": { "typeName": "String", "expression": { "type": "Literal", "value": "Total" } },
        "outputValue": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "variables.Total" } },
        "id": "l3outTotal",
        "name": "OutputTotal",
        "type": "Elsa.SetOutput",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Output Total", "designer": { "position": { "x": 960, "y": 200 } } }
      },
      {
        "outputName": { "typeName": "String", "expression": { "type": "Literal", "value": "Status" } },
        "outputValue": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "variables.Status" } },
        "id": "l3outStatus",
        "name": "OutputStatus",
        "type": "Elsa.SetOutput",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Output Status", "designer": { "position": { "x": 1200, "y": 200 } } }
      },
      {
        "outputName": { "typeName": "String", "expression": { "type": "Literal", "value": "Tier" } },
        "outputValue": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "variables.Tier" } },
        "id": "l3outTier",
        "name": "OutputTier",
        "type": "Elsa.SetOutput",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Output Tier", "designer": { "position": { "x": 1440, "y": 200 } } }
      },
      {
        "outputName": { "typeName": "String", "expression": { "type": "Literal", "value": "Message" } },
        "outputValue": { "typeName": "Object", "expression": { "type": "JavaScript", "value": "variables.Message" } },
        "id": "l3outMessage",
        "name": "OutputMessage",
        "type": "Elsa.SetOutput",
        "version": 1,
        "customProperties": { "canStartWorkflow": false, "runAsynchronously": false },
        "metadata": { "displayText": "Output Message", "designer": { "position": { "x": 1680, "y": 200 } } }
      }
    ],
    "connections": [
      { "source": { "activity": "l3captureId", "port": "Done" }, "target": { "activity": "l3captureCount", "port": "In" } },
      { "source": { "activity": "l3captureCount", "port": "Done" }, "target": { "activity": "l3forEachLine", "port": "In" } },
      { "source": { "activity": "l3forEachLine", "port": "Done" }, "target": { "activity": "l3decision", "port": "In" } },
      { "source": { "activity": "l3decision", "port": "True" }, "target": { "activity": "l3statusReview", "port": "In" } },
      { "source": { "activity": "l3decision", "port": "False" }, "target": { "activity": "l3statusApproved", "port": "In" } },
      { "source": { "activity": "l3statusReview", "port": "Done" }, "target": { "activity": "l3tierSwitch", "port": "In" } },
      { "source": { "activity": "l3statusApproved", "port": "Done" }, "target": { "activity": "l3tierSwitch", "port": "In" } },
      { "source": { "activity": "l3tierSwitch", "port": "Gold" }, "target": { "activity": "l3tierGold", "port": "In" } },
      { "source": { "activity": "l3tierSwitch", "port": "Silver" }, "target": { "activity": "l3tierSilver", "port": "In" } },
      { "source": { "activity": "l3tierSwitch", "port": "Default" }, "target": { "activity": "l3tierBronze", "port": "In" } },
      { "source": { "activity": "l3tierGold", "port": "Done" }, "target": { "activity": "l3message", "port": "In" } },
      { "source": { "activity": "l3tierSilver", "port": "Done" }, "target": { "activity": "l3message", "port": "In" } },
      { "source": { "activity": "l3tierBronze", "port": "Done" }, "target": { "activity": "l3message", "port": "In" } },
      { "source": { "activity": "l3message", "port": "Done" }, "target": { "activity": "l3outTotal", "port": "In" } },
      { "source": { "activity": "l3outTotal", "port": "Done" }, "target": { "activity": "l3outStatus", "port": "In" } },
      { "source": { "activity": "l3outStatus", "port": "Done" }, "target": { "activity": "l3outTier", "port": "In" } },
      { "source": { "activity": "l3outTier", "port": "Done" }, "target": { "activity": "l3outMessage", "port": "In" } }
    ]
  }
}
