@model CreateOrderViewModel
@{
    ViewData["Title"] = "Create order";
}

<p>
    Submitting starts the <strong>published</strong> workflow in <code>Workflow:DefinitionId</code>.
    It loops over the lines (<code>ForEach</code>) to compute the total, decides the status
    (<code>Decision</code>: above 1000 → <code>needs_review</code>), picks a tier (<code>Switch</code>),
    and builds a message with <strong>Liquid</strong>. Blank rows are ignored.
</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="error"></div>

    <table>
        <thead>
            <tr><th>Product</th><th>Quantity</th><th>Unit price</th></tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Form.Lines.Count; i++)
            {
                <tr>
                    <td><input asp-for="Form.Lines[i].Product" /></td>
                    <td><input asp-for="Form.Lines[i].Quantity" type="number" min="0" /></td>
                    <td><input asp-for="Form.Lines[i].UnitPrice" type="number" step="0.01" min="0" /></td>
                </tr>
            }
        </tbody>
    </table>

    <div><button type="submit">Create order</button></div>
</form>

@if (Model.Error is not null)
{
    <div class="box error" role="alert">@Model.Error</div>
}

@if (Model.Result is { } r)
{
    <div class="box">
        <h2>Order @(r.OrderStatus ?? "(no status output)")</h2>
        <dl>
            <dt>Output "Total" (ForEach + JavaScript)</dt>
            <dd>@(r.Total?.ToString("0.00") ?? "(missing)")</dd>
            <dt>Output "Status" (Decision)</dt>
            <dd>@(r.OrderStatus ?? "(missing)")</dd>
            <dt>Output "Tier" (Switch)</dt>
            <dd>@(r.Tier ?? "(missing)")</dd>
            <dt>Output "Message" (Liquid)</dt>
            <dd>@(r.Message ?? "(missing)")</dd>
            <dt>Workflow Status / SubStatus</dt>
            <dd>@r.WorkflowStatus / @r.WorkflowSubStatus</dd>
            <dt>Workflow instance ID</dt>
            <dd>@r.WorkflowInstanceId</dd>
        </dl>
    </div>
}
