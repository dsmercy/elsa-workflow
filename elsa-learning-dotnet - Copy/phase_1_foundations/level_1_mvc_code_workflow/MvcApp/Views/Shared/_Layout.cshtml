<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Level 1</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 46rem; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
        header { border-bottom: 1px solid #d0d7de; margin-bottom: 1.5rem; }
        label { display: block; margin-top: .75rem; font-weight: 600; }
        input { padding: .4rem; width: 100%; max-width: 20rem; }
        button { margin-top: 1rem; padding: .5rem 1rem; cursor: pointer; }
        .error { color: #cf222e; }
        .box { border: 1px solid #d0d7de; border-radius: 6px; padding: 1rem; margin-top: 1.5rem; }
        dt { font-weight: 600; margin-top: .5rem; }
        dd { margin-left: 0; font-family: ui-monospace, monospace; word-break: break-all; }
    </style>
</head>
<body>
    <header>
        <h1>Phase 1 · Level 1 · Code-first workflow in MVC</h1>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
