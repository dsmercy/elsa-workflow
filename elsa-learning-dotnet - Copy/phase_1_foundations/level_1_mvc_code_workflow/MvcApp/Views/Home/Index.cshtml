@model HelloPageViewModel
@{
    ViewData["Title"] = "Run HelloWorkflow";
}

<p>
    Submitting this form runs the C# workflow <code>HelloWorkflow</code> (definition <code>L1_Hello</code>)
    in-process with <code>IWorkflowRunner</code>, passing an <code>Order</code> as workflow input.
    The <code>WriteLine</code> steps print to the terminal running the app.
</p>

<form asp-action="Run" method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label asp-for="Form.Product">Product</label>
    <input asp-for="Form.Product" />
    <span asp-validation-for="Form.Product" class="error"></span>

    <label asp-for="Form.Amount">Amount</label>
    <input asp-for="Form.Amount" type="number" step="0.01" />
    <span asp-validation-for="Form.Amount" class="error"></span>

    <div><button type="submit">Run workflow</button></div>
</form>

@if (Model.Error is not null)
{
    <div class="box error" role="alert">@Model.Error</div>
}

@if (Model.Result is { } r)
{
    <div class="box">
        <h2>Result</h2>
        <dl>
            <dt>Workflow output "Message"</dt>
            <dd>@(r.Message ?? "(no output)")</dd>
            <dt>Status / SubStatus</dt>
            <dd>@r.Status / @r.SubStatus</dd>
            <dt>Workflow instance ID</dt>
            <dd>@r.WorkflowInstanceId</dd>
            <dt>Order ID</dt>
            <dd>@r.Order.OrderId</dd>
        </dl>
        <p>Submit again: you get a <em>new</em> instance ID each time, but the definition stays the same.</p>
    </div>
}
